# Backend Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=production

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/secure_file_hub?retryWrites=true&w=majority

# JWT Security Secret & Expiration
JWT_SECRET=your_jwt_strong_secret_key_here
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads

# Allowed Frontend URL for CORS (e.g., https://your-project.vercel.app)
CLIENT_URL=https://your-frontend.vercel.app
