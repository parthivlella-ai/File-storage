# Backend Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas in Production, Local in Development)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/secure_file_hub?retryWrites=true&w=majority

# JWT Security Secret & Expiration (Must be at least 32 characters in production)
JWT_SECRET=your_jwt_strong_secret_key_here
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS (without trailing slash)
CLIENT_URL=https://your-frontend.vercel.app

# Maximum Allowed File Upload Size (in MB)
MAX_FILE_SIZE_MB=50

# Storage Provider: 'r2' (Cloudflare R2), 's3' (AWS S3), or 'local' (Disk Storage)
# In local development, leave unset or 'local' to use local disk storage.
STORAGE_PROVIDER=r2

# Local Storage Directory (Used when STORAGE_PROVIDER=local or as staging directory)
UPLOAD_DIR=uploads

# Cloudflare R2 Object Storage (Recommended for Production: S3 compatible, 0 egress fees)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=secure-file-hub

# Alternative: AWS S3 / Generic S3 Compatible Storage
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_s3_access_key_id_here
# S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_here
# S3_BUCKET_NAME=your_s3_bucket_name_here
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
