# Frontend Environment Configuration - Secure File Hub
#
# Production (Vercel): Set to your deployed backend URL ending in /api
# Example: https://secure-file-hub-api.onrender.com/api
VITE_API_URL=https://YOUR-BACKEND-DOMAIN/api

# Local Development:
# Leave VITE_API_URL empty so the Vite dev server proxy automatically
# routes all /api requests to http://localhost:5000
